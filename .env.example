# Local development only. Copy to .env on your machine.
# Production uses .env.production on the server — see .env.production.example

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-in-production
AUTH_TOKEN_TTL=8h
# Cookie session (httpOnly). Localhost defaults work with Vite proxy.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=0
COOKIE_DOMAIN=
# Gmail SMTP (App Password). Leave SMTP_USER/SMTP_PASS empty in local dev to log reset links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ลี้ไฟเบอร์บอร์ด IPMS <your.account@gmail.com>
# Optional. Enables Socket.IO multi-instance + shared auth rate limits.
REDIS_URL=
METRICS_TOKEN=
TRUST_PROXY=0
SEED_DEMO_DATA=1
ATTACHMENT_STORAGE_DIR=./storage/issue-attachments
ATTACHMENT_MAX_FILES=15
ATTACHMENT_MAX_BYTES=26214400
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lfbsmart_project
DB_POOL_LIMIT=30
SHARED_DB_NAME=shared_auth
CENTER_USER_TABLE=Center_user_lfb
